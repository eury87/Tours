# ==============================================================================
# VARIABLES DE ENTORNO - PLATAFORMA DE TOURS & RESERVAS MULTI-TENANT
# ==============================================================================

# Puerto del Servidor Backend
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS SUPABASE (POSTGRESQL)
# ------------------------------------------------------------------------------
# Obtén estas credenciales en: https://supabase.com -> Tu Proyecto -> Project Settings -> API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. DUAL-STORAGE CLOUDINARY (RESPALDO EN LA NUBE DE FOTOS Y COMPROBANTES)
# ------------------------------------------------------------------------------
# Obtén estas credenciales en: https://cloudinary.com -> Dashboard
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz123456

# ------------------------------------------------------------------------------
# 3. CORREO ELECTRÓNICO TRANSACCIONAL (RESEND / SMTP)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
BUSINESS_EMAIL=euryhealer@gmail.com
PLATFORM_AUDIT_EMAIL=euryhealer@gmail.com

# ------------------------------------------------------------------------------
# 4. WHATSAPP BUSINESS CLOUD API (OPCIONAL SI SE USA SIMULADOR O BAILEYS QR)
# ------------------------------------------------------------------------------
WHATSAPP_API_URL=https://graph.facebook.com/v19.0/PHONE_NUMBER_ID/messages
WHATSAPP_API_KEY=WA_TOKEN_PROD_SAMPLE
